# Azure AD B2C configuration for fitness course sign-up/sign-in
# Example authority base:
# https://your-tenant-name.b2clogin.com/your-tenant-name.onmicrosoft.com
VITE_AZURE_B2C_AUTHORITY_BASE=
VITE_AZURE_B2C_CLIENT_ID=
VITE_AZURE_B2C_SIGNIN_POLICY=
VITE_AZURE_B2C_SIGNUP_POLICY=
# Optional override (defaults to https://<your-domain>/courses)
VITE_AZURE_B2C_REDIRECT_URI=

# Optional completion certificate provider URL (defaults to Credly homepage).
# Replace with your provider claim URL template when ready.
VITE_COURSE_CERTIFICATE_PROVIDER_URL=
